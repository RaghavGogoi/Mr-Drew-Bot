# ==============================================================================
# DISCORD BOT CREDENTIALS (REQUIRED)
#
# 1. Go to the Discord Developer Portal: https://discord.com/developers/applications
# 2. Select or create your application.
# 3. Copy the "Application ID" from General Information -> APPLICATION_ID
# 4. Navigate to "Bot" -> Reset/Copy the "Token" -> DISCORD_TOKEN
# 5. (Optional) Copy Public Key -> PUBLIC_KEY
# ==============================================================================
DISCORD_TOKEN=your_discord_bot_token_here
APPLICATION_ID=your_discord_application_id_here
PUBLIC_KEY=your_discord_public_key_here

# ==============================================================================
# PLAYER CONFIGURATION (OPTIONAL)
# ==============================================================================
# Default playback volume percentage (1 - 200)
DEFAULT_VOLUME=100

# Number of seconds the bot waits before disconnecting after ALL human users leave the voice channel
EMPTY_VC_TIMEOUT_SECONDS=60

# Maximum number of tracks allowed in the active queue
MAX_QUEUE_SIZE=500

# Maximum number of tracks saved in playback history
MAX_HISTORY_SIZE=50

# Directory for storing uploaded temporary audio files
TEMP_UPLOADS_DIR=temp_uploads

# ==============================================================================
# SPOTIFY API CREDENTIALS (OPTIONAL)
#
# If provided, enables faster Spotify metadata resolution and search autocomplete.
# If omitted, Spotify links will still resolve and play via YouTube fallback search.
# Get credentials at: https://developer.spotify.com/dashboard
# ==============================================================================
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
